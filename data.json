{
  "memeId": "maomao_discover_regret",
  "title": "Идея vs Реальность",
  "templateImage": "./assets/images/maomao_blank.jpg",
  "fontSettings": {
    "family": "Montserrat, sans-serif",
    "color": "#000000",
    "weight": "800",
    "textAlign": "center"
  },
  "layout": {
    "topBlock": {
      "position": { "x": "2%", "y": "5%", "width": "46%", "height": "40%" },
      "templateText": "Сделать {awesome_thing} через ИИ и добавить туда\n{crazy_idea},\nчтобы защита прошла {terrible_truth}!",
      "interactiveFields": [
        { 
          "id": "awesome_thing", 
          "label": "Что сдаём?", 
          "placeholder": "лабораторную работу", 
          "defaultText": "лабораторную работу" 
        },
        { 
          "id": "crazy_idea", 
          "label": "Безумная идея", 
          "placeholder": "трехэтажный JSON", 
          "defaultText": "трехэтажный JSON" 
        },
        { 
          "id": "terrible_truth", 
          "label": "Как пройдет защита лабы?", 
          "placeholder": "ужасно", 
          "defaultText": "ужасно" 
        }
      ]
    },
    "bottomBlock": {
      "position": { "x": "2%", "y": "55%", "width": "46%", "height": "40%" },
      "templateText": "Сделать её,\nпросто используя {easyly_way}...",
      "interactiveFields": [
        { 
          "id": "easyly_way", 
          "label": "Что сказал использовать препод для решения?", 
          "placeholder": "методичку", 
          "defaultText": "методичку" 
        }
      ]
    }
  }
}